# App
APP_NAME=lottery-backend
APP_VERSION=                          # optional, e.g. 1.0.0
APP_PORT=3000
NODE_ENV=development

# API Documentation
ENABLE_API_DOC=true                   # Enable Swagger UI at /api/doc
ENABLE_SWAGGER_DEMO=true              # Show demo endpoints in Swagger
APP_API_VERSION=                      # API version (e.g. git commit hash), defaults to 'dev'

# Logger
LOG_LEVEL=info                    # debug | info | warn | error
LOG_PRETTY=true                   # true for pretty print, false for JSON
LOG_AUTO_LOGGING=true             # auto log HTTP requests
LOG_FILE_ENABLED=true             # enable file logging
LOG_ERROR_PATH=logs/error.log     # error log file path
LOG_WARN_PATH=logs/warn.log       # warn log file path
LOG_COMBINED_PATH=                # combined log file path (optional)

# Database (PostgreSQL)
# - Using containerized PG: DATABASE_HOST will be overridden by docker-compose.data.yml
# - Using external PG: Set your actual connection info below
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lottery
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_MAX_CONNECTIONS=10
DATABASE_RUN_MIGRATIONS=false     # Auto-run migrations on app start

# Docker
# Usage:
#   Dev + containerized PG:  docker compose -f docker-compose.yml -f docker-compose.data.yml -f docker-compose.dev.yml up
#   Dev + external PG:       docker compose -f docker-compose.yml -f docker-compose.dev.yml up
#   Prod + containerized PG: docker compose -f docker-compose.yml -f docker-compose.data.yml up
#   Prod + external PG:      docker compose up
COMPOSE_PROJECT_NAME=lottery-backend-dev              # dev | production (affects container names)
LOTTERY_FORWARD_API_PORT=3000
LOTTERY_FORWARD_DB_PORT=5432
